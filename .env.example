# Next.js (frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend scripts (never commit the real key)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: for LLM wrapper (server route)
#OPENAI_API_KEY=

# Postmark option
POSTMARK_SERVER_TOKEN=... 

# OR SendGrid option
SENDGRID_API_KEY=...

# --- Copilot LLM setup ---
OPENAI_API_KEY=      # any non-empty placeholder, SDK just checks presence
OPENAI_BASE_URL=
LLM_MODEL=

# --- Automated tests (put real values in .env.test, never commit) ---
# The RLS cross-user isolation suite (tests/security/rls-isolation.test.ts)
# runs only when ALL of these are set; otherwise it is skipped.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
TEST_USER_B_ID=       # public.users.id of seeded test user B
